		(uuid "265b9296-58ba-4ba3-b051-a05a259fc404")
	)
	(text "- Via stiching\n	FR4 (epsilon_relative): ~4.2 - 4.8\n	f = 2.4GHz = 2.4*10^9 Hz\n	v = c / sqrt(epsilon_relative) = (3*10^8) / (sqrt(4.5) = ~1.42*10^8\n	lambda = v / f = (1.42*10^8) / 2.4*10^9 = 0.059\n	lambda / 10 = 0.059 / 10 = 0.0059 = ~5.9mm\n	"
		(exclude_from_sim no)
		(at 62.484 26.67 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4bd0060b-eab9-44f5-b54f-3f9cf22b9a84")
	)
